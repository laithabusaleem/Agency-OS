# =============================================================================
# Agency OS — environment variables (Phase 1 + Phase 2 Agent Runtime)
# Copy to .env.local for local development. Never commit real secrets.
# Server-only values are validated in src/lib/env.ts / src/agent/config.ts and
# must not be prefixed with NEXT_PUBLIC_ (those would be exposed to the browser).
# =============================================================================

# Runtime
NODE_ENV=development

# Public app URL (safe for browser; used for absolute links / redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Agency OS

# Session encryption password for iron-session (min 32 characters).
# Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# SQLite database file path (relative to project root or absolute).
# Swap DATABASE_URL / dialect later for PostgreSQL without changing domain code.
DATABASE_PATH=./data/agency.sqlite

# Optional: enable verbose structured logs (true/false)
LOG_PRETTY=true

# Integration placeholders (server-only). Leave empty to show "not configured".
# Do not put API keys in NEXT_PUBLIC_* variables.
STRIPE_SECRET_KEY=
SLACK_BOT_TOKEN=
RESEND_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Demo seed controls (local/dev only). Never enable in production.
SEED_DEMO_DATA=true

# -----------------------------------------------------------------------------
# Phase 2 — Agent runtime
# -----------------------------------------------------------------------------

# Default provider for new jobs when not specified: mock | gemini | groq | openrouter
# Production MUST NOT silently fall back to mock if a real provider fails.
AGENT_DEFAULT_PROVIDER=mock

# Explicit opt-in only. Default false — mock is blocked in production.
AGENT_ALLOW_MOCK_IN_PRODUCTION=false

# Global kill switch (also toggleable by admins in the Agents UI / DB settings)
AGENT_KILL_SWITCH=false

# Budgets (integer cents). Per-job budget can also be set at enqueue time.
AGENT_GLOBAL_BUDGET_CENTS=50000
AGENT_DEFAULT_JOB_BUDGET_CENTS=100

# Worker tuning
AGENT_DEFAULT_TIMEOUT_MS=30000
AGENT_DEFAULT_MAX_ATTEMPTS=3
AGENT_WORKER_POLL_MS=500
AGENT_WORKER_LOCK_MS=60000

# Provider credentials (server-only). Missing keys fail closed — no mock fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Phase 3 — Lead acquisition
# -----------------------------------------------------------------------------

# Brave Search API (https://brave.com/search/api/)
# Leave empty to use manual entry + CSV only. Missing key fails closed for research.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# Default research provider when not specified: brave | manual | csv | mock
ACQUISITION_DEFAULT_PROVIDER=manual

# Allow mock research provider (tests/dev). Never enable silently in production.
ACQUISITION_ALLOW_MOCK=false

# Evidence freshness TTL (hours)
ACQUISITION_EVIDENCE_TTL_HOURS=168

# Max public page fetches per research run (robots/rate-limit respectful)
ACQUISITION_MAX_FETCHES_PER_RUN=3

# -----------------------------------------------------------------------------
# Phase 4 — Sales & outreach
# -----------------------------------------------------------------------------

# Master send switch. DEFAULT false — never send unless explicitly enabled
# after campaign + message approval. Agents cannot override this.
OUTREACH_SENDING_ENABLED=false

# Emergency stop — halts all sends immediately when true
OUTREACH_EMERGENCY_STOP=false

OUTREACH_DAILY_QUOTA=50
OUTREACH_PER_CAMPAIGN_LIMIT=100
OUTREACH_RATE_LIMIT_PER_MINUTE=10

# Verified sender identity (required when enabling sends)
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=Agency OS

# Resend (https://resend.com) — permitted categories only; see docs/OUTREACH.md
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

OUTREACH_UNSUBSCRIBE_BASE_URL=http://localhost:3000/api/outreach/unsubscribe
# HMAC secret for unsubscribe tokens (defaults to SESSION_SECRET if unset)
OUTREACH_UNSUBSCRIBE_SECRET=

# Optional AES-GCM key for sealing integration secrets at rest (≥32 chars)
CREDENTIALS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Phase 5 — Service delivery
# -----------------------------------------------------------------------------

DELIVERY_RUNS_ENABLED=true
DELIVERY_DEPLOY_ENABLED=false
DELIVERY_PUBLICATION_ENABLED=false
DELIVERY_SPENDING_ENABLED=false
DELIVERY_DESTRUCTIVE_ENABLED=false
# Permanently blocked — do not enable in production
DELIVERY_ALLOW_MODEL_CODE_EXECUTION=false
DELIVERY_WORKSPACE_ROOT=./data/workspaces
# Set true after `npx playwright install chromium` for real browser QA
DELIVERY_PLAYWRIGHT_ENABLED=false
